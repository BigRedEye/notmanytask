<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css">
        <title>{{ .Title }}</title>

        {{ template "metrika" }}

        <style>
.navbar-brand {
    font-size: 3rem;
    font-weight: 300
}

.nav-link {
    color: rgba(0, 0, 0, 0.9);
}

.rank-1 {
    background-color: #ffd970;
}

.rank-2 {
    background-color: #e2e3e5;
}

.rank-3 {
    background-color: #ecc8a8;
}
        </style>
    </head>
    <body>
      <nav class="navbar navbar-light bg-light">
          <div class="container">
              <span class="navbar-brand mb-0 h1"><a href="/" class="text-decoration-none text-dark">{{.CourseName}}</a></span>
              <div class="row">
                  {{ if .Links }}
                  <div class="col-auto">
                      <a class="nav-link" href="{{ .Links.Deadlines }}"><h5>Tasks</h5></a>
                  </div>
                  <div class="col-auto">
                      <a class="nav-link" href="{{ .Links.Standings }}"><h5>Standings</h5></a>
                  </div>
                  <div class="col-auto">
                      <a class="nav-link" href="{{ .Links.SubmitFlag }}"><h5>Submit flag</h5></a>
                  </div>
                  {{ if .Links.Repository }}
                  <div class="col-auto">
                      <a class="nav-link" href="{{ .Links.Repository }}"><h5>My Repo</h5></a>
                  </div>
                  {{ end }}
                  {{ if .Links.Submits }}
                  <div class="col-auto">
                      <a class="nav-link" href="{{ .Links.Submits }}"><h5>Submits</h5></a>
                  </div>
                  {{ end }}
                  <div class="col-auto">
                      <a class="nav-link" href="{{ .Links.Logout }}"><h5>Logout</h5></a>
                  </div>
                  {{ else }}
                  <div class="col-auto">
                      <a class="nav-link" href="/"><h5>Login</h5></a>
                  </div>
                  {{ end }}
              </div>
          </div>
      </nav>

        <div class="container p-2 my-2">
            <h2>🏆 {{ .Task }}</h2>
            <p class="text-muted">
                Results submitted before {{ .Deadline }} count.
                A correct solution earns the task score; the first place gets up to
                &times;{{ printf "%g" .Multiplier }} of it, the last place gets exactly the score.
            </p>

            {{ if .Error }}
                <div class="alert alert-danger">{{ .Error }}</div>
            {{ end }}

            {{ if .Entries }}
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Student</th>
                        <th scope="col">Metric</th>
                        <th scope="col">Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    {{ range $i, $entry := .Entries }}
                    <tr {{ if eq $i 0 }}class="rank-1"{{ else if eq $i 1 }}class="rank-2"{{ else if eq $i 2 }}class="rank-3"{{ end }}>
                        <th scope="row">{{ inc $i }}</th>
                        <td>{{ .Name }}</td>
                        <td>{{ printf "%.2f" .Metric }}</td>
                        <td>{{ .SubmittedAt.Format "02 Jan 15:04" }}</td>
                    </tr>
                    {{ end }}
                </tbody>
            </table>
            {{ else }}
            <div class="alert alert-secondary">No results yet. Be the first!</div>
            {{ end }}
        </div>
    </body>
</html>
