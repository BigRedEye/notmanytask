log:
  level: info
  filename: /var/log/notmanytask/notmanytask.log
  maxSize: 50MB
  maxBackups: 10
  compress: true

gitlab:
  baseURL: https://gitlab.com
  taskURLPrefix: https://gitlab.com/{USER}/{REPO}/-/tree/main/tasks
  defaultReadme: '
    # Решения

    Ваши решения создаются и тестируются в отдельных ветках (кнопка Branches выше). Сливать ветки в master не нужно.
  '
  group:
    name: {GITLAB_GROUP_NAME}
    id: {GITLAB_GROUP_ID}
  api:
    token: {GITLAB_TOKEN}
  application:
    secret: {GITLAB_APPLICATION_SECRET}
    clientId: {GITLAB_APPLICATION_CLIENT_ID}

  # Merge request workflow (base course): student repositories are forked
  # from the template project in this GitLab, every submits/<task> branch
  # gets a merge request into the target branch, green and quiet merge
  # requests are merged by the robot.
  # Remove the whole block for the pipeline workflow (advanced course).
  #
  # templateProject: {GITLAB_GROUP_NAME}/template
  # mergeRequests:
  #   targetBranch: main
  #   reviewTtl: 72h
  #   robotLogin: {GITLAB_API_TOKEN_OWNER_LOGIN}

endpoints:
  hostname: https://{SITE_DOMAIN}
  home: /
  flag: /flag
  login: /login
  logout: /logout
  signup: /signup
  standings: /standings
  retakes: /retakes
  oauthCallback: /finish
  api:
    report: /api/report
    flag: /api/flag
    standings: /api/standings

server:
  listenAddress: ":18080"
  courseName: "HSE C++"
  # Optional: require an email on signup matching this regexp
  # signupEmailPattern: '^.*@(edu\.)?hse\.ru$'
  cookies:
    authenticationKey: {RANDOM_COOKIE_AUTH_KEY}
    encryptionKey: {RANDOM_COOKIE_ENCRYPTION_KEY}

database:
  host: db
  port: 5432
  user: postgres
  pass: {POSTGRES_PASSWORD}
  name: postgres

testing:
  tokens:
  - {GRADER_OR_CRASHME_TOKEN}
  - {GRADER_OR_CRASHME_TOKEN_2}

groups:
- name: hse
  secret: ihatecpp
  deadlinesUrl: https://gitlab.com/{USER}/{REPO}/-/raw/main/deadlines/hse.yml
  deadlinesFormat: v2
  # Optional subgroups with their own signup secrets and standings filter
  # subgroups:
  # - name: 254-1
  #   secret: ihatecpp-254-1
- name: test
  secret: ilovecpp
  deadlinesUrl: https://gitlab.com/{USER}/{REPO}/-/raw/main/deadlines/test.yml
  deadlinesFormat: v2

pullIntervals:
  projects: 10s
  # Full pipeline scan; drop it in the merge request workflow (the scorer
  # does not read pipelines there, and grader reports are fetched anyway)
  pipelines: 30s
  deadlines: 10s
  # Required in the merge request workflow
  # mergeRequests: 60s
